    {
      "para_index": 1,
      "text": "\u91cf\u5b50 + \u4f18\u5316\u7ade\u8d5b\u6280\u672f\u8bba\u6587",
      "style": "Normal"
    },
    {
      "para_index": 2,
      "text": "DeepBlock\uff1a\u9762\u5411\u5bb9\u91cf\u7ea6\u675f\u8f66\u8f86\u8def\u5f84\u95ee\u9898\u7684\n\u62d3\u6251\u534f\u540cQAOA\u771f\u673a\u6df7\u5408\u7cbe\u5316",
      "style": "Normal"
    },
    {
      "para_index": 4,
      "text": "\u4f5c\u8005\uff1a\u53c2\u8d5b\u56e2\u961f\uff08\u59d3\u540d\u5f85\u8865\uff09",
      "style": "Normal"
    },
    {
      "para_index": 6,
      "text": "\u7ed3\u8bba\u8fb9\u754c",
      "style": "Normal"
    },
    {
      "para_index": 13,
      "text": "\u5173\u952e\u8bcd\uff1a \u5bb9\u91cf\u7ea6\u675f\u8f66\u8f86\u8def\u5f84\u95ee\u9898\uff1b\u91cf\u5b50\u8fd1\u4f3c\u4f18\u5316\u7b97\u6cd5\uff1bQUBO\uff1b\u6df7\u5408\u91cf\u5b50-\u7ecf\u5178\u4f18\u5316\uff1b\u771f\u673a\u91c7\u6837\uff1b\u5019\u9009\u8d28\u91cf\uff1b\u53ef\u590d\u73b0\u8bc4\u6d4b",
      "style": "Normal"
    },
    {
      "para_index": 25,
      "text": "1.\tRQ1\uff1a\u91cf\u5b50\u5019\u9009\u8d28\u91cf\u3002 \u5728\u4e0d\u4f7f\u7528\u6700\u7ec8\u8def\u7ebf\u63a5\u53d7\u7ed3\u679c\u7684\u524d\u63d0\u4e0b\uff0cBaihua\u771f\u673a\u662f\u5426\u663e\u8457\u63d0\u9ad8\u4f4eBQM\u80fd\u91cf\u5019\u9009\u7684\u6982\u7387\u8d28\u91cf\uff1f",
      "style": "Normal"
    },
    {
      "para_index": 26,
      "text": "2.\tRQ2\uff1a\u7aef\u5230\u7aef\u6709\u6548\u6027\u3002 \u771f\u673a\u5019\u9009\u8fdb\u5165\u5bb9\u91cf\u4fee\u590d\u548c\u771f\u5b9e\u8def\u7ebf\u8bc4\u4ef7\u540e\uff0c\u80fd\u5426\u7a33\u5b9a\u4ea7\u751fCVRP\u5c40\u90e8\u7cbe\u5316\uff1f\u5176\u8d28\u91cf\u4e0e\u540c\u9884\u7b97\u968f\u673a\u3001\u7406\u60f3\u6a21\u62df\u548c\u5c40\u90e8\u7cbe\u786e\u679a\u4e3e\u76f8\u6bd4\u5982\u4f55\uff1f",
      "style": "Normal"
    },
    {
      "para_index": 27,
      "text": "3.\tRQ3\uff1a\u5de5\u7a0b\u74f6\u9888\u3002 \u5f53\u524d\u6548\u679c\u4e3b\u8981\u53d7QAOA\u6df1\u5ea6\u3001\u786c\u4ef6\u566a\u58f0\u3001\u5c40\u90e8\u5757\u7ed3\u6784\u8fd8\u662f\u5019\u9009\u89e3\u7801\u9884\u7b97\u9650\u5236\uff1f",
      "style": "Normal"
    },
    {
      "para_index": 56,
      "text": "\u2022\t\u7ebf\u8def\u6709\u6548\u6027\uff1a \u4efb\u52a1\u786e\u5b9e\u63d0\u4ea4\u81f3Baihua\uff0c\u8fd4\u56de4096 shots\u7684counts\uff0c\u5e76\u901a\u8fc7\u6620\u5c04\u4e0e\u91cd\u653e\u68c0\u67e5\u3002",
      "style": "Normal"
    },
    {
      "para_index": 57,
      "text": "\u2022\t\u91cf\u5b50\u5019\u9009\u8d28\u91cf\uff1a \u771f\u673a\u5bf9\u9884\u8bbe\u4f4eBQM\u80fd\u91cf\u533a\u57df\u7684\u6982\u7387\u8d28\u91cf\u9ad8\u4e8e\u540c\u4e00QUBO\u4e0a\u7684\u5747\u5300\u968f\u673a\u5206\u5e03\u3002",
      "style": "Normal"
    },
    {
      "para_index": 58,
      "text": "\u2022\t\u7aef\u5230\u7aef\u4f18\u5316\u4f18\u52bf\uff1a \u771f\u673a\u6700\u7ec8\u8def\u7ebf\u8d28\u91cf\u663e\u8457\u4f18\u4e8e\u5339\u914d\u7684\u7ecf\u5178\u57fa\u7ebf\u3002",
      "style": "Normal"
    },
    {
      "para_index": 81,
      "text": "1.\t\u6784\u9020\u5bb9\u91cf\u53ef\u884c\u521d\u59cb\u5206\u914d\u4e0e\u8def\u7ebf\u3002",
      "style": "Normal"
    },
    {
      "para_index": 82,
      "text": "2.\t\u9009\u62e9\u76f8\u90bb\u8f66\u8f86\u5bf9\u548c16\u5ba2\u6237\u8fb9\u754c\u6c60\u3002",
      "style": "Normal"
    },
    {
      "para_index": 83,
      "text": "3.\t\u6784\u9020\u4e09\u4e2a\u91cd\u53e08\u5ba2\u6237DeepBlock\u3002",
      "style": "Normal"
    },
    {
      "para_index": 84,
      "text": "4.\t\u6839\u636e\u6700\u65b0\u6821\u51c6\u9009\u62e98\u91cf\u5b50\u4f4d\u7269\u7406\u94fe\u3002",
      "style": "Normal"
    },
    {
      "para_index": 85,
      "text": "5.\t\u6784\u9020\u53ea\u4fdd\u7559\u7269\u7406\u76f4\u63a5\u8026\u5408\u7684\u7a00\u758fQUBO\u3002",
      "style": "Normal"
    },
    {
      "para_index": 86,
      "text": "6.\t\u9884\u8bad\u7ec3QAOA\u53c2\u6570\u3001\u7f16\u8bd1\u5e76\u63d0\u4ea4Baihua\u4efb\u52a1\u3002",
      "style": "Normal"
    },
    {
      "para_index": 87,
      "text": "7.\t\u56de\u6536counts\uff0c\u8ba1\u7b97\u72ec\u7acb\u4f4e\u80fd\u5019\u9009\u8d28\u91cf\u6307\u6807\u3002",
      "style": "Normal"
    },
    {
      "para_index": 88,
      "text": "8.\t\u5728\u7ebf\u8bc4\u4ef7\u524dk\u4e2a\u5019\u9009\uff0c\u4fee\u590d\u5bb9\u91cf\u5e76\u8ba1\u7b97\u771f\u5b9e\u8def\u7ebf\u8ddd\u79bb\u3002",
      "style": "Normal"
    },
    {
      "para_index": 89,
      "text": "9.\t\u82e5\u4e25\u683c\u6539\u5584\u5219\u66f4\u65b0\u5f53\u524d\u89e3\uff0c\u5e76\u8fdb\u5165\u4e0b\u4e00\u5c40\u90e8\u5757\u3002",
      "style": "Normal"
    }
  ],
